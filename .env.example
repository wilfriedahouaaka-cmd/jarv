# ============================================================
# .env.example — GABARIT PUBLIC DES VARIABLES D'ENVIRONNEMENT
# ============================================================
#
# RÔLE
#   Ce fichier montre la liste complète des variables d'environnement
#   attendues, SANS aucune valeur. C'est la version qui peut être
#   commitée sur Git, pour que quelqu'un d'autre sache quoi remplir.
#
# PROCESSUS
#   1. cp .env.example .env
#   2. Tu remplis les valeurs dans .env
#   3. Tu ne commites JAMAIS .env, uniquement .env.example
#
# RÈGLE
#   Toute nouvelle variable ajoutée à .env doit aussi être ajoutée
#   ici, au même endroit, avec le même commentaire.
# ============================================================


# ----------------------------------------------------------
# ANTHROPIC (Claude)
# Clés : https://console.anthropic.com/settings/keys
# ----------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------
# OPENAI
# Clés : https://platform.openai.com/api-keys
# ----------------------------------------------------------
OPENAI_API_KEY=

# ----------------------------------------------------------
# NOTION
# Clés : https://www.notion.so/my-integrations
# ----------------------------------------------------------
NOTION_API_KEY=

# ----------------------------------------------------------
# GOOGLE (Drive, Sheets, Gmail, Calendar)
# Console API : https://console.cloud.google.com/apis/credentials
# APIs à activer dans le projet : Drive, Sheets, Gmail...
# ----------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------
# YOUTUBE (API Data v3)
# Clés : https://console.cloud.google.com/apis/credentials
# L'API YouTube Data v3 doit être activée dans le projet GCP.
# ----------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ----------------------------------------------------------
# VERCEL
# Clés : https://vercel.com/account/settings/tokens
# Le token doit porter le scope "vercel" pour les déploiements.
# ----------------------------------------------------------
VERCEL_TOKEN=

# ----------------------------------------------------------
# GITHUB
# Tokens : https://github.com/settings/tokens
# Scopes : repo (pour le push), workflow (pour les Actions).
# Un token à usage unique et à durée courte vaut mieux.
# ----------------------------------------------------------
GITHUB_TOKEN=

# ----------------------------------------------------------
# STRIPE (paiements)
# Clés : https://dashboard.stripe.com/apikeys
# La clé secrète est côté serveur uniquement.
# ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------
# SUPPLÉMENTAIRES (stack actuelle)
# ----------------------------------------------------------

# Supabase : https://supabase.com/dashboard/account/api-keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
# La clé service_role contourne la RLS. Serveur uniquement, jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=
